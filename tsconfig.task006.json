{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "esnext.disposable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".task006-build",
    "types": [
      "node"
    ]
  },
  "include": [
    "graph/**/*.ts",
    "verifier/**/*.ts",
    "tests/**/*.ts"
  ]
}
