{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/task010",
    "rootDir": ".",
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "noEmitOnError": true
  },
  "include": [
    "ledger/**/*.ts",
    "verifier/ledger/**/*.ts"
  ]
}