{
  "compilerOptions": {
    "target": "ES2020",

    "module": "commonjs",
    "moduleResolution": "node",

    "strict": true,
    "isolatedModules": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "ignoreDeprecations": "6.0",

    "types": [
      "jest",
      "node"
    ]
  },

  "include": [
    "src",
    "tests"
  ]
}
